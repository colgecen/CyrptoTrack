#!/usr/bin/env bash
#
# cryptotrack - run and build tool
#
# Behaviour:
#   ./cryptotrack                  Run the app from source (unbuilt). Stop it with Ctrl+C.
#   cryptotrack                    Open the build menu (after one-time --install, no "./" needed).
#
# Commands (reserved flags; every other argument is passed to the app):
#   ./cryptotrack --install        Install the `cryptotrack` command into ~/.local/bin
#                                  and register the app (icon + launcher entry) as a system app
#   ./cryptotrack --uninstall      Remove that command, the launcher entry and the icon
#   ./cryptotrack --build          Interactive build menu
#   ./cryptotrack --build <os> <format> [arch]
#   ./cryptotrack --build --list   List all build targets
#
# Targets:
#   linux   : appimage | targz | rpm | source | binary | all
#   windows : exe | all                       (only when WINDOWS_SUPPORTED="yes")
#   arch    : x86_64 | aarch64 | all          (default: all)
#
# Assets are written to build/dist/ as <project>-<version>-<os>-<arch>.<ext>
# and a SHA256SUMS file is generated next to them.
#
set -euo pipefail

# ---- per-project settings (the only part that changes between projects) ----
APP="cryptotrack"                 # lowercase command name
BIN="cryptotrack"                 # name of the built binary
PROJECT="AvaloniaAppCrypto.csproj" # .NET project file
SUMMARY="Real-time cryptocurrency market tracker with portfolio, price alerts and news"
LICENSE_ID="MIT"                  # SPDX identifier, must match the LICENSE file
WINDOWS_SUPPORTED="yes"           # "no" -> Linux-only releases
ICON="assets/icon.png"            # optional; skipped when the file is missing
ICON_RADIUS_PCT="20"              # corner radius as % of icon size (square icons get rounded)
VERSION="${VERSION:-1.0.0}"       # override: VERSION=1.2.0 ./cryptotrack ...
ARCHS_DEFAULT="x86_64 aarch64"

# ---- locate the repository root (resolves symlinks) ----
resolve_root() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
ROOT="$(resolve_root)"
DIST="$ROOT/build/dist"
STAGE="$ROOT/build/.stage"
CACHE="$ROOT/build/.cache"

die() { echo "ERROR: $*" >&2; exit 1; }

find_dotnet() {
  DOTNET=$(command -v dotnet 2>/dev/null || command -v /usr/lib64/dotnet/dotnet 2>/dev/null || true)
  [ -n "$DOTNET" ] || die ".NET SDK not found. Install the .NET 8 SDK first."
}

# =====================================================================
# Run mode: start the unbuilt app straight from source
# =====================================================================
run_app() {
  find_dotnet
  cd "$ROOT"
  # exec replaces this shell, so Ctrl+C reaches the app directly.
  export DOTNET_ROLL_FORWARD="${DOTNET_ROLL_FORWARD:-Major}"
  exec "$DOTNET" run --project "$ROOT/$PROJECT" -- "$@"
}

# =====================================================================
# Install / uninstall the bare `cryptotrack` command
# =====================================================================
WRAPPER_MARK="# cryptotrack-wrapper"
DESKTOP_MARK="# cryptotrack-desktop"

# prepare_icon <dest>: write the icon to <dest>, rounding square corners (needs ImageMagick).
prepare_icon() {
  local src="$ROOT/$ICON" dest="$1" im="" ident="" w r corner
  [ -f "$src" ] || return 1
  if command -v magick >/dev/null 2>&1; then
    im="magick"; ident="magick identify"
  elif command -v convert >/dev/null 2>&1; then
    im="convert"; ident="identify"
  fi
  if [ -z "$im" ]; then
    echo "NOTE: ImageMagick not found, icon copied without rounding."
    cp "$src" "$dest"; return 0
  fi
  w="$($ident -format '%w' "$src")"
  r=$(( w * ICON_RADIUS_PCT / 100 ))
  # Is the top-left pixel already transparent? Then the icon is already rounded.
  corner="$($ident -format '%[pixel:p{0,0}]' "$src" 2>/dev/null || echo opaque)"
  case "$corner" in
    *",0)"|"none"|"transparent") cp "$src" "$dest" ;;
    *)
      $im "$src" -alpha set \
        \( -size "${w}x${w}" xc:none -fill white \
           -draw "roundrectangle 0,0 $((w-1)),$((w-1)) $r,$r" \) \
        -compose DstIn -composite "$dest"
      ;;
  esac
}

install_desktop_entry() {
  local apps="$HOME/.local/share/applications"
  local icons="$HOME/.local/share/icons/hicolor/512x512/apps"
  local iconline=""
  mkdir -p "$apps" "$icons"
  if prepare_icon "$icons/$APP.png"; then iconline="Icon=$APP"; fi
  cat > "$apps/$APP.desktop" << DESKTOP
$DESKTOP_MARK
[Desktop Entry]
Type=Application
Name=CryptoTrack
Comment=$SUMMARY
Exec="$ROOT/$APP"
$iconline
Terminal=false
Categories=Finance;
DESKTOP
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$apps" 2>/dev/null || true
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
  echo "Installed: $apps/$APP.desktop (appears in the application launcher)"
}

uninstall_desktop_entry() {
  local f="$HOME/.local/share/applications/$APP.desktop"
  if [ -f "$f" ] && grep -q "$DESKTOP_MARK" "$f"; then
    rm -f "$f" "$HOME/.local/share/icons/hicolor/512x512/apps/$APP.png"
    echo "Removed: $f"
  fi
}

do_install() {
  local bindir="$HOME/.local/bin"
  mkdir -p "$bindir"
  printf '#!/usr/bin/env bash\n%s\nexec "%s/%s" --build "$@"\n' \
    "$WRAPPER_MARK" "$ROOT" "$APP" > "$bindir/$APP"
  chmod +x "$bindir/$APP"
  install_desktop_entry
  echo "Installed: $bindir/$APP"
  case ":$PATH:" in
    *":$bindir:"*) echo "Done. Type '$APP' in any folder to open the build menu." ;;
    *)
      echo "NOTE: $bindir is not in PATH. Add this line to ~/.bashrc:"
      echo '  export PATH="$HOME/.local/bin:$PATH"'
      echo "Then open a new terminal or run: source ~/.bashrc"
      ;;
  esac
}

do_uninstall() {
  local f="$HOME/.local/bin/$APP"
  if [ -f "$f" ] && grep -q "$WRAPPER_MARK" "$f"; then
    rm -f "$f"
    echo "Removed: $f"
  else
    echo "Nothing to remove."
  fi
  uninstall_desktop_entry
}

# =====================================================================
# Helpers
# =====================================================================
banner() {
  echo "=============================================="
  echo "  $APP build tool  v$VERSION"
  echo "=============================================="
}

list_targets() {
  echo "linux   : appimage | targz | rpm | source | binary | all"
  if [ "$WINDOWS_SUPPORTED" = "yes" ]; then
    echo "windows : exe | all"
  fi
  echo "arch    : x86_64 | aarch64 | all (default)"
}

usage() {
  banner
  echo
  echo "Usage:"
  echo "  $APP                          Interactive build menu"
  echo "  $APP <os> <format> [arch]     Build directly"
  echo "  $APP --list                   List targets"
  echo
  list_targets
}

host_arch() {
  case "$(uname -m)" in
    aarch64|arm64) echo aarch64 ;;
    *) echo x86_64 ;;
  esac
}

rid() {
  case "$1:$2" in
    linux:x86_64|linux:amd64) echo linux-x64 ;;
    linux:aarch64|linux:arm64) echo linux-arm64 ;;
    windows:x86_64|windows:amd64) echo win-x64 ;;
    windows:aarch64|windows:arm64) echo win-arm64 ;;
    *) die "Unknown target: $1/$2 (valid: linux|windows, x86_64|aarch64)" ;;
  esac
}

# Windows assets use "arm64"; Linux assets use "aarch64".
arch_label() {
  if [ "$1" = "windows" ] && [ "$2" = "aarch64" ]; then echo arm64; else echo "$2"; fi
}

asset() { echo "$DIST/$APP-$VERSION-$1-$(arch_label "$1" "$2").$3"; }

# publish <os> <arch> <output-dir>
publish() {
  local os="$1" arch="$2" out="$3" target
  target="$(rid "$os" "$arch")"
  echo "==> Publishing $target"
  rm -rf "$out"
  mkdir -p "$out"
  DOTNET_CLI_TELEMETRY_OPTOUT=1 "$DOTNET" publish "$ROOT/$PROJECT" \
    -c Release -r "$target" --self-contained true \
    -p:PublishSingleFile=true \
    -p:IncludeNativeLibrariesForSelfExtract=true \
    -p:DebugType=None -p:DebugSymbols=false \
    -p:Version="$VERSION" \
    -o "$out" >/dev/null
  [ -f "$out/$BIN" ] || [ -f "$out/$BIN.exe" ] || die "Publish did not produce $BIN"
}

# =====================================================================
# Linux
# =====================================================================
fetch() { # fetch <url> <dest>
  local url="$1" dest="$2"
  [ -s "$dest" ] && return 0
  rm -f "$dest"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 --retry-delay 2 --connect-timeout 15 --max-time 120 "$url" -o "$dest" || rm -f "$dest"
  fi
  if [ ! -s "$dest" ] && command -v wget >/dev/null 2>&1; then
    wget -O "$dest" "$url" || rm -f "$dest"
  fi
  [ -s "$dest" ] || die "Download failed: $url"
  chmod +x "$dest"
}

linux_appimage() {
  local arch="$1" appdir tool runtime
  appdir="$STAGE/$APP-$arch.AppDir"
  tool="$CACHE/appimagetool"
  runtime="$CACHE/runtime-$arch"
  mkdir -p "$CACHE"

  if command -v appimagetool >/dev/null 2>&1; then
    tool="$(command -v appimagetool)"
  else
    fetch "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$(host_arch).AppImage" "$tool"
  fi
  fetch "https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-$arch" "$runtime"

  rm -rf "$appdir"
  mkdir -p "$appdir/usr/bin" "$appdir/usr/share/applications"
  publish linux "$arch" "$appdir/usr/bin"
  if [ -f "$appdir/usr/bin/$BIN" ]; then
    chmod +x "$appdir/usr/bin/$BIN"
    rm -f "$appdir/usr/bin/$BIN.exe"
  fi

  if prepare_icon "$appdir/$APP.png"; then
    ln -sf "$APP.png" "$appdir/.DirIcon"
  fi

  cat > "$appdir/AppRun" << APPRUN
#!/bin/sh
HERE="\$(dirname "\$(readlink -f "\$0")")"
export APPDIR="\$HERE"
exec "\$HERE/usr/bin/$BIN" "\$@"
APPRUN
  chmod +x "$appdir/AppRun"

  cat > "$appdir/$APP.desktop" << DESKTOP
[Desktop Entry]
Name=CryptoTrack
Exec=$BIN
Icon=$APP
Terminal=false
Type=Application
Categories=Finance;
DESKTOP
  cp "$appdir/$APP.desktop" "$appdir/usr/share/applications/"

  mkdir -p "$DIST"
  local out
  out="$(asset linux "$arch" AppImage)"
  rm -f "$out"
  # Extract the tool so it also works where FUSE is unavailable.
  ( cd "$STAGE" && "$tool" --appimage-extract >/dev/null 2>&1 || true )
  if [ -x "$STAGE/squashfs-root/AppRun" ]; then
    ARCH="$arch" "$STAGE/squashfs-root/AppRun" --runtime-file "$runtime" -n "$appdir" "$out"
    rm -rf "$STAGE/squashfs-root"
  else
    ARCH="$arch" "$tool" --runtime-file "$runtime" -n "$appdir" "$out"
  fi
  echo "==> $out"
}

linux_targz() {
  local arch="$1" dir
  local name="$APP-$VERSION-linux-$arch"
  dir="$STAGE/$name"
  rm -rf "$dir"; mkdir -p "$dir" "$DIST"
  publish linux "$arch" "$dir"
  cp "$ROOT/README.md" "$ROOT/LICENSE" "$dir/" 2>/dev/null || true
  tar -C "$STAGE" -czf "$(asset linux "$arch" tar.gz)" "$name"
  echo "==> $(asset linux "$arch" tar.gz)"
}

ensure_nfpm() {
  local tarball="$CACHE/nfpm.tar.gz"
  if command -v nfpm >/dev/null 2>&1; then
    NFPM="$(command -v nfpm)"; return 0
  fi
  if [ -x "$CACHE/nfpm" ]; then
    NFPM="$CACHE/nfpm"; return 0
  fi
  mkdir -p "$CACHE"
  fetch "https://github.com/goreleaser/nfpm/releases/download/v2.49.0/nfpm_2.49.0_Linux_$(host_arch).tar.gz" "$tarball"
  tar -xzf "$tarball" -C "$CACHE" nfpm
  chmod +x "$CACHE/nfpm"
  NFPM="$CACHE/nfpm"
}

linux_rpm() {
  local arch="$1" top nf_arch
  top="$STAGE/rpm-$arch"
  case "$arch" in
    x86_64|amd64) nf_arch="amd64" ;;
    aarch64|arm64) nf_arch="arm64" ;;
    *) die "Unknown architecture: $arch" ;;
  esac
  ensure_nfpm
  rm -rf "$top"
  mkdir -p "$top" "$DIST"
  publish linux "$arch" "$top/publish"
  install -m 0755 "$top/publish/$BIN" "$top/$BIN"
  prepare_icon "$top/$APP.png" || true
  cat > "$top/$APP.desktop" << DESKTOP
[Desktop Entry]
Name=CryptoTrack
Exec=$BIN
Icon=$APP
Terminal=false
Type=Application
Categories=Finance;
DESKTOP
  cat > "$top/nfpm.yaml" << YAML
name: $APP
arch: $nf_arch
platform: linux
version: $VERSION
section: utils
priority: optional
maintainer: colgecen
description: $SUMMARY
license: $LICENSE_ID
rpm:
  buildhost: localhost
contents:
  - src: $BIN
    dst: /usr/bin/$BIN
  - src: $APP.desktop
    dst: /usr/share/applications/$APP.desktop
  - src: $APP.png
    dst: /usr/share/icons/hicolor/512x512/apps/$APP.png
YAML
  ( cd "$top" && "$NFPM" package --config nfpm.yaml --packager rpm --target "$(asset linux "$arch" rpm)" )
  echo "==> $(asset linux "$arch" rpm)"
}

linux_binary() {
  local arch="$1"
  mkdir -p "$DIST"
  publish linux "$arch" "$STAGE/binary-$arch"
  install -m 0755 "$STAGE/binary-$arch/$BIN" "$(asset linux "$arch" bin)"
  echo "==> $(asset linux "$arch" bin)"
}

linux_source() {
  mkdir -p "$DIST"
  ( cd "$ROOT" && git archive --format=tar.gz --prefix="$APP-$VERSION/" \
      -o "$DIST/$APP-$VERSION-source.tar.gz" HEAD )
  echo "==> $DIST/$APP-$VERSION-source.tar.gz"
}

# =====================================================================
# Windows
# =====================================================================
windows_exe() {
  local arch="$1" dir
  dir="$STAGE/windows-$arch"
  mkdir -p "$DIST"
  publish windows "$arch" "$dir"
  cp "$dir/$BIN.exe" "$(asset windows "$arch" exe)"
  echo "==> $(asset windows "$arch" exe)"
}

# =====================================================================
# Dispatch
# =====================================================================
build_target() {
  local os="$1" fmt="$2" archsel="${3:-all}" archs a f
  find_dotnet
  mkdir -p "$STAGE" "$DIST"
  banner
  echo "Target: os=$os format=$fmt arch=$archsel version=$VERSION"
  echo

  if [ "$archsel" = "all" ]; then archs="$ARCHS_DEFAULT"; else archs="$archsel"; fi

  case "$os" in
    linux)
      [ "$fmt" = "all" ] && fmt="appimage targz rpm source"
      for f in $fmt; do
        case "$f" in
          source) linux_source ;;
          appimage|targz|rpm|binary) for a in $archs; do "linux_$f" "$a"; done ;;
          *) die "Unknown linux format: $f (valid: appimage | targz | rpm | source | binary | all)" ;;
        esac
      done
      ;;
    windows)
      [ "$WINDOWS_SUPPORTED" = "yes" ] || die "This project is Linux-only; Windows builds are disabled."
      [ "$fmt" = "all" ] && fmt="exe"
      case "$fmt" in
        exe) for a in $archs; do windows_exe "$a"; done ;;
        *) die "Unknown windows format: $fmt (valid: exe | all)" ;;
      esac
      ;;
    *) die "Unknown OS: $os (valid: linux | windows)" ;;
  esac

  # Checksums for every asset in build/dist
  ( cd "$DIST" && rm -f SHA256SUMS && sha256sum -- * > SHA256SUMS )
  echo
  echo "Done. Assets are in build/dist/ (SHA256SUMS included)."
}

interactive() {
  local os fmt
  banner
  echo
  echo "Select target operating system:"
  if [ "$WINDOWS_SUPPORTED" = "yes" ]; then
    select c in "Linux" "Windows" "Cancel"; do
      case "$c" in
        Linux) os="linux"; break ;;
        Windows) os="windows"; break ;;
        Cancel|"") echo "Cancelled."; exit 0 ;;
        *) echo "Invalid choice." ;;
      esac
    done
  else
    os="linux"
    echo "  (Linux only)"
  fi

  echo
  echo "Select package format:"
  if [ "$os" = "linux" ]; then
    select c in "All (AppImage, tar.gz, rpm, source)" "AppImage" "tar.gz" "rpm" "Source code" "Binary only" "Cancel"; do
      case "$REPLY" in
        1) fmt="all"; break ;;
        2) fmt="appimage"; break ;;
        3) fmt="targz"; break ;;
        4) fmt="rpm"; break ;;
        5) fmt="source"; break ;;
        6) fmt="binary"; break ;;
        7|"") echo "Cancelled."; exit 0 ;;
        *) echo "Invalid choice." ;;
      esac
    done
  else
    select c in "All (.exe x86_64 + arm64)" "Cancel"; do
      case "$REPLY" in
        1) fmt="exe"; break ;;
        2|"") echo "Cancelled."; exit 0 ;;
        *) echo "Invalid choice." ;;
      esac
    done
  fi
  build_target "$os" "$fmt" all
}

build_main() {
  case "${1:-}" in
    "") interactive ;;
    -h|--help|help) usage ;;
    -l|--list|list) list_targets ;;
    linux|windows)
      [ $# -ge 2 ] || { echo "Format missing."; list_targets; exit 1; }
      build_target "$1" "$2" "${3:-all}"
      ;;
    *) echo "Unknown command: $1"; echo; usage; exit 1 ;;
  esac
}

# ---- entry point ----
case "${1:-}" in
  --build)     shift; build_main "$@" ;;
  --install)   do_install ;;
  --uninstall) do_uninstall ;;
  *)           run_app "$@" ;;   # "./cryptotrack" (+ any app arguments)
esac
